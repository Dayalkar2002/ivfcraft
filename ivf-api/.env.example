PORT=3000
JWT_SECRET=smart_ivf_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h
# Comma-separated browser origins
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,https://ivfcraft.vercel.app
ALLOW_DEMO_LOGIN=true

# SQL Server – copy from Web.config connectionStrings name="ConsmArt"
# DB_SERVER can be host or host,port (e.g. 111.118.177.44,8463)
DB_SERVER=your_sql_server
DB_PORT=
DB_DATABASE=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_LOGIN_TIMEOUT_MS=10000

# Same as Web.config appSettings SatGroup
SAT_GROUP=IND

# Consent form clinic merge fields (optional)
CONSENT_CLINIC_NAME=IVF Clinic
CONSENT_CLINIC_ADDRESS=
CONSENT_CONSULTANT1=
CONSENT_CONSULTANT2=
